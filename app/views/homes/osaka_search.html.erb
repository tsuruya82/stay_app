<%= render 'shared/search_form' %>
<a><%= @osakas.count %>件が見つかりました。</a>

<% @osakas.each do |osaka| %>
  <table border>
    <thead>
      <tr>
        <td>施設名</td>
        <td>住所</td>
        <td>施設詳細</td>
        <td>宿泊料金</td>
        <td>詳細</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= osaka.name %></td>
        <td><%= osaka.address %></td>
        <td><%= osaka.introduction %></td>
        <td><%= osaka.charge_day %></td>
        <td><%= link_to '詳細はこちら', "/rooms/#{osaka.id}" %></td>
      </tr>
    </tbody>
  </table>
<% end %>
