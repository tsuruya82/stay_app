<%= search_form_for @q do |f| %>
    <%= f.label :name_cont %>
    <%= f.search_field :name_cont %>

    <%= f.submit %>
<% end %>

<% @rooms.each do |room| %>
  <tr>
    <td><%= room.id %></td>
    <td><%= room.name %></td>
    <td><%= room.introduction %></td>
    <td><%= room.charge_day %></td>
  </tr>
<% end %>
