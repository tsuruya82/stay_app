<%= render 'shared/search_form' %>

<a><%= @rooms.count %>件が見つかりました。</a>

<% @rooms.each do |room| %>
  <table border>
    <thead>
      <tr>
        <td>施設名</td>
        <td>住所</td>
        <td>施設詳細</td>
        <td>宿泊料金</td>
        <td>詳細</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><%= room.name %></td>
        <td><%= room.address %></td>
        <td><%= room.introduction %></td>
        <td><%= room.charge_day %></td>
        <td><%= link_to '詳細はこちら', "/rooms/#{room.id}" %></td>
      </tr>
    </tbody>
  </table>
<% end %>
