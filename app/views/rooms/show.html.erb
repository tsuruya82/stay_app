<h3>施設詳細</h3>
<%= link_to '戻る', 'javascript:history.back()' %>
<%= link_to "編集", edit_room_path %>

<p>施設画像 :
<% if @room.image? %>
  <%= image_tag @room.image.url %>
<% else %>
  <%= image_tag("default_room.png") %>
<% end %>
</p>

<table>
  <tr>
    <th>名前</th>
    <td><%= @room.name %></td>
  </tr>
  
  <tr>
    <th>一言紹介</th>
    <td><%= @room.introduction %></td>
  </tr>

  <tr>
    <th>宿泊料金</th>
    <td><%= @room.charge_day %></td>
  </tr>
</table>