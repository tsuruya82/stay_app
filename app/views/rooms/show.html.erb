<h3>施設詳細</h3>

<%= Date.today %>

<%= link_to '戻る', 'javascript:history.back()' %>
<%= link_to "編集", "/rooms/#{@room.id}/edit" %>

<p>施設画像 :
<% if @room.image? %>
  <%= image_tag @room.image.url %>
<% else %>
  <%= image_tag("default_room.png") %>
<% end %>
</p>

<table>
  <tr>
    <th>名前</th>
    <td><%= @room.name %></td>
  </tr>
  
  <tr>
    <th>一言紹介</th>
    <td><%= @room.introduction %></td>
  </tr>

  <tr>
    <th>宿泊料金</th>
    <td><%= @room.charge_day %></td>
  </tr>
</table>

<h3>予約</h3>

<ul>
<%= form_with model: @reservation, method: :get, url: new_reservation_path do |f| %>
    <%= f.label :room_id, 'room_id' %>
    <%= f.hidden_field :room_id, value: @room.id %>

    <%= f.label :user_id, 'user_id' %>
    <%= f.hidden_field :user_id, value: current_user.id %>

    <%= f.label :check_in_date, 'チェックイン日' %>
    <li><%= f.date_field :check_in_date %></li>

    <%= f.label :check_out_date, 'チェックアウト日' %>
    <li><%= f.date_field :check_out_date %></li>

    <%= f.label :number_of_customers, '人数' %>
    <li><%= f.number_field :number_of_customers %></li>

    <li><%= f.submit "予約する" %></li>
  <% end %>
</ul> 
