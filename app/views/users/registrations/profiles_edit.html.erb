<%= form_with model: @user, url: users_profiles_update_path do |f| %>
  <table>
    <tr>
      <th><%= f.label :name ,"名前" %></th>
      <td><%= f.text_field :name %></td>
    </tr>
    <tr>
      <th><%= f.label :introduce ,"一言紹介" %></th>
      <td><%= f.text_area :introduce %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "編集を完了する" %></li>
    </ul>
  </div>
<% end %>